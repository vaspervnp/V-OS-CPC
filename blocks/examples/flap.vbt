START SPRITE:1
SPEED 2 1
FOREVER
  MOVE
  BOUNCE
END

START SPRITE:1
FOREVER
  WAIT 6
  IF COSTUME = 1
    COSTUME 2
  ELSE
    COSTUME 1
  END
END

START SPRITE:2
FOREVER
  PRINT COSTUME 8 20
  WAIT 50
  NEXT_COSTUME
END

 "variables": {
  "score": 0,
  "lives": 3,
  "level": 0,
  "left": 32,
  "serve": 0
 },
 "scripts": [
  {
   "when": {
    "event": "start"
   },
   "do": [
    {
     "block": "print",
     "text": "SCORE",
     "x": 4,
     "y": 16
    },
    {
     "block": "print",
     "text": "LIVES",
     "x": 116,
     "y": 16
    },
    {
     "block": "broadcast",
     "message": "new"
    }
   ]
  },
  {
   "when": {
    "event": "receive",
    "message": "new"
   },
   "do": [
    {
     "block": "set",
     "var": "score",
     "to": 0
    },
    {
     "block": "set",
     "var": "lives",
     "to": 3
    },
    {
     "block": "set",
     "var": "level",
     "to": 0
    },
    {
     "block": "print",
     "text": "         ",
     "x": 60,
     "y": 140
    },
    {
     "block": "print",
     "text": "            ",
     "x": 48,
     "y": 156
    },
    {
     "block": "broadcast",
     "message": "level"
    }
   ]
  },
  {
   "when": {
    "event": "receive",
    "message": "level"
   },
   "do": [
    {
     "block": "set",
     "var": "left",
     "to": 32
    },
    {
     "block": "change",
     "var": "level",
     "by": 1
    },
    {
     "block": "broadcast",
     "message": "show"
    }
   ]
  },
  {
   "when": {
    "event": "receive",
    "message": "show"
   },
   "do": [
    {
     "block": "print",
     "value": {
      "var": "score"
     },
     "x": 60,
     "y": 16
    },
    {
     "block": "print",
     "text": "  ",
     "x": 176,
     "y": 16
    },
    {
     "block": "print",
     "value": {
      "var": "lives"
     },
     "x": 176,
     "y": 16
    }
   ]
  },
  {
   "when": {
    "event": "key",
    "key": "space"
   },
   "do": [
    {
     "block": "if",
     "cond": {
      "op": "=",
      "a": {
       "var": "lives"
      },
      "b": 0
     },
     "then": [
      {
       "block": "broadcast",
       "message": "new"
      }
     ]
    }
   ]
  },
  {
   "sprite": "ball",
   "when": {
    "event": "receive",
    "message": "level"
   },
   "do": [
    {
     "block": "set",
     "var": "serve",
     "to": 1
    },
    {
     "block": "forever",
     "do": [
      {
       "block": "if",
       "cond": {
        "op": "=",
        "a": {
         "var": "serve"
        },
        "b": 1
       },
       "then": [
        {
         "block": "hide"
        },
        {
         "block": "go_to",
         "x": {
          "op": "+",
          "a": {
           "prop": "x",
           "of": "bat"
          },
          "b": 14
         },
         "y": 228
        },
        {
         "block": "wait",
         "frames": 40
        },
        {
         "block": "go_to",
         "x": {
          "op": "+",
          "a": {
           "prop": "x",
           "of": "bat"
          },
          "b": 14
         },
         "y": 228
        },
        {
         "block": "set_velocity",
         "vx": {
          "random": [
           -2,
           2
          ]
         },
         "vy": {
          "op": "-",
          "a": 0,
          "b": {
           "op": "+",
           "a": 2,
           "b": {
            "var": "level"
           }
          }
         }
        },
        {
         "block": "if",
         "cond": {
          "op": "=",
          "a": {
           "prop": "vx"
          },
          "b": 0
         },
         "then": [
          {
           "block": "set_velocity",
           "vx": 1,
           "vy": {
            "prop": "vy"
           }
          }
         ]
        },
        {
         "block": "if",
         "cond": {
          "op": "<",
          "a": {
           "prop": "vy"
          },
          "b": -5
         },
         "then": [
          {
           "block": "set_velocity",
           "vx": {
            "prop": "vx"
           },
           "vy": -5
          }
         ]
        },
        {
         "block": "show"
        },
        {
         "block": "set",
         "var": "serve",
         "to": 0
        }
       ]
      },
      {
       "block": "move"
      },
      {
       "block": "bounce"
      },
      {
       "block": "if",
       "cond": {
        "op": "and",
        "a": {
         "touching": "bat"
        },
        "b": {
         "op": ">",
         "a": {
          "prop": "vy"
         },
         "b": 0
        }
       },
       "then": [
        {
         "block": "set_velocity",
         "vx": {
          "op": "/",
          "a": {
           "op": "-",
           "a": {
            "prop": "x"
           },
           "b": {
            "op": "+",
            "a": {
             "prop": "x",
             "of": "bat"
            },
            "b": 14
           }
          },
          "b": 4
         },
         "vy": {
          "op": "-",
          "a": 0,
          "b": {
           "prop": "vy"
          }
         }
        },
        {
         "block": "if",
         "cond": {
          "op": "=",
          "a": {
           "prop": "vx"
          },
          "b": 0
         },
         "then": [
          {
           "block": "set_velocity",
           "vx": 1,
           "vy": {
            "prop": "vy"
           }
          }
         ]
        },
        {
         "block": "start_note",
         "note": 72,
         "frames": 2,
         "channel": 0
        }
       ]
      },
      {
       "block": "if",
       "cond": {
        "op": ">",
        "a": {
         "prop": "y"
        },
        "b": 244
       },
       "then": [
        {
         "block": "hide"
        },
        {
         "block": "change",
         "var": "lives",
         "by": -1
        },
        {
         "block": "broadcast",
         "message": "show"
        },
        {
         "block": "noise",
         "pitch": 20,
         "frames": 10,
         "channel": 1
        },
        {
         "block": "if",
         "cond": {
          "op": "=",
          "a": {
           "var": "lives"
          },
          "b": 0
         },
         "then": [
          {
           "block": "print",
           "text": "GAME OVER",
           "x": 60,
           "y": 140
          },
          {
           "block": "print",
           "text": "SPACE: AGAIN",
           "x": 48,
           "y": 156
          },
          {
           "block": "stop"
          }
         ]
        },
        {
         "block": "set",
         "var": "serve",
         "to": 1
        }
       ]
      }
     ]
    }
   ]
  },
  {
   "sprite": "ball",
   "when": {
    "event": "receive",
    "message": "hit"
   },
   "do": [
    {
     "block": "set_velocity",
     "vx": {
      "prop": "vx"
     },
     "vy": {
      "op": "-",
      "a": 0,
      "b": {
       "prop": "vy"
      }
     }
    },
    {
     "block": "broadcast",
     "message": "show"
    },
    {
     "block": "start_note",
     "note": 84,
     "frames": 2,
     "channel": 2
    },
    {
     "block": "if",
     "cond": {
      "op": "=",
      "a": {
       "var": "left"
      },
      "b": 0
     },
     "then": [
      {
       "block": "hide"
      },
      {
       "block": "wait",
       "frames": 50
      },
      {
       "block": "broadcast",
       "message": "level"
      }
     ]
    }
   ]
  },
  {
   "sprite": "bat",
   "when": {
    "event": "start"
   },
   "do": [
    {
     "block": "forever",
     "do": [
      {
       "block": "if",
       "cond": {
        "key_held": "left"
       },
       "then": [
        {
         "block": "change_x",
         "by": -4
        }
       ]
      },
      {
       "block": "if",
       "cond": {
        "key_held": "right"
       },
       "then": [
        {
         "block": "change_x",
         "by": 4
        }
       ]
      },
      {
       "block": "if",
       "cond": {
        "op": "<",
        "a": {
         "prop": "x"
        },
        "b": 0
       },
       "then": [
        {
         "block": "set_x",
         "to": 0
        }
       ]
      },
      {
       "block": "if",
       "cond": {
        "op": ">",
        "a": {
         "prop": "x"
        },
        "b": 160
       },
       "then": [
        {
         "block": "set_x",
         "to": 160
        }
       ]
      }
     ]
    }
   ]
  },
  {

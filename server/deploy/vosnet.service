# V-OS NET (server/DESIGN.md §8): /etc/systemd/system/vosnet.service
#   sudo useradd --system --home /var/lib/vosnet --shell /usr/sbin/nologin vosnet
#   sudo systemctl daemon-reload && sudo systemctl enable --now vosnet
[Unit]
Description=V-OS NET telnet server
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=vosnet
WorkingDirectory=/opt/vosnet
ExecStart=/usr/bin/dotnet /opt/vosnet/VosNet.Server.dll
Environment=DOTNET_ENVIRONMENT=Production
Environment=VOSNET__Database=/var/lib/vosnet/vosnet.db
Environment=VOSNET__Keys=/var/lib/vosnet/keys
Environment=VOSNET__Web=http://127.0.0.1:5080
Environment=VOSNET__TelnetPorts=23,2323
StateDirectory=vosnet
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
